# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local mirror of booking inquiries — contains guests' names and emails
/data

# raw client media, kept out of the repo; public/ holds the encoded output.
# The staging folder has moved around during the project (root, then dev/) —
# matched unanchored so it's excluded wherever it ends up.
pngs/
*.mp4
!/public/videos/*.mp4
.tmp-frames

# vercel
.vercel

# cloudflare / opennext build output and local dev state
.open-next
.wrangler
cloudflare-env.d.ts
.dev.vars

# typescript
*.tsbuildinfo
next-env.d.ts
