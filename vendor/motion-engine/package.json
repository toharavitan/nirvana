{
  "name": "@leadstrikes/motion-engine",
  "version": "0.2.0",
  "description": "Internal motion framework for LeadStrikes premium websites. Smooth scrolling, page transitions, scroll-driven storytelling, and a shared motion language built on GSAP + Lenis.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "@gsap/react": "^2.1.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.0",
    "next": "^15.0.0 || ^16.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
